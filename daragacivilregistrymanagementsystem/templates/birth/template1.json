{
  "id": "birth_template_1",
  "doc_type": "birth",
  "description": "Generic PSA / municipal birth certificate (flexible keyword+regex).",
  "match": {
    "keywords_any": [
      "CERTIFICATE OF LIVE BIRTH",
      "LIVE BIRTH",
      "NAME OF CHILD",
      "DATE OF BIRTH",
      "PLACE OF BIRTH",
      "NAME OF MOTHER",
      "NAME OF FATHER"
    ],
    "min_any": 3
  },
  "fields": {
    "registry_number": {
      "patterns": [
        "(?:Registry\\s*(?:No\\.|Number)\\s*[:\\-]?\\s*)(?P<value>[A-Za-z0-9\\-\\/]{3,})",
        "(?:REGISTRY\\s*(?:NO\\.|NUMBER)\\s*[:\\-]?\\s*)(?P<value>[A-Za-z0-9\\-\\/]{3,})"
      ]
    },
    "name_of_child": {
      "patterns": [
        "(?:Name\\s+of\\s+Child\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})",
        "(?:CHILD\\s*NAME\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})"
      ]
    },
    "sex": {
      "patterns": [
        "(?:Sex\\s*[:\\-]?\\s*)(?P<value>Male|Female|M|F)\\b"
      ]
    },
    "date_of_birth": {
      "patterns": [
        "(?:Date\\s+of\\s+Birth\\s*[:\\-]?\\s*)(?P<value>\\d{1,2}[\\-/]\\d{1,2}[\\-/]\\d{2,4}|\\d{4}[\\-/]\\d{1,2}[\\-/]\\d{1,2}|\\d{1,2}\\s+[A-Z]{3,9}\\s+\\d{4})",
        "(?:Born\\s+on\\s*[:\\-]?\\s*)(?P<value>\\d{1,2}\\s+[A-Z]{3,9}\\s+\\d{4})"
      ]
    },
    "place_of_birth": {
      "patterns": [
        "(?:Place\\s+of\\s+Birth\\s*[:\\-]?\\s*)(?P<value>[A-Za-z0-9][A-Za-z0-9 '\\-.,]{2,})"
      ]
    },
    "name_of_mother": {
      "patterns": [
        "(?:Name\\s+of\\s+Mother\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})",
        "(?:Mother\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})"
      ]
    },
    "name_of_father": {
      "patterns": [
        "(?:Name\\s+of\\s+Father\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})",
        "(?:Father\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})"
      ]
    }
  }
}

