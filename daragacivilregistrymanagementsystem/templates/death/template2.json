{
  "id": "death_template_2",
  "doc_type": "death",
  "description": "Alternative death layout with short labels / OCR noise.",
  "match": {
    "keywords_any": [
      "DEATH",
      "DECEASED",
      "CAUSE",
      "PLACE",
      "DATE"
    ],
    "min_any": 3
  },
  "fields": {
    "registry_number": {
      "patterns": [
        "(?:REGI(?:S|5)TR(?:Y|V)\\s*(?:NO\\.|NUMBER)?\\s*[:\\-]?\\s*)(?P<value>[A-Za-z0-9\\-\\/]{3,})"
      ]
    },
    "name_of_deceased": {
      "patterns": [
        "(?:NAME\\s+OF\\s+DECEASED\\s*[:\\-]?\\s*)(?P<value>.+)",
        "(?:DECEASED\\s*[:\\-]?\\s*)(?P<value>[A-Za-z][A-Za-z '\\-.,]{2,})"
      ]
    },
    "name_of_mother": {
      "patterns": [
        "(?:MOTHER(?:'?S)?\\s+(?:MAIDEN\\s+)?NAME\\s*[:\\-]?\\s*)(?P<value>.+)",
        "(?:NAME\\s+OF\\s+MOTHER\\s*[:\\-]?\\s*)(?P<value>.+)",
        "(?:MAIDEN\\s+NAME\\s+OF\\s+MOTHER\\s*[:\\-]?\\s*)(?P<value>.+)"
      ]
    },
    "date_of_death": {
      "patterns": [
        "(?:DOD\\s*[:\\-]?\\s*)(?P<value>\\d{4}[\\-/]\\d{1,2}[\\-/]\\d{1,2}|\\d{1,2}[\\-/]\\d{1,2}[\\-/]\\d{2,4})",
        "(?:DATE\\s+OF\\s+DEATH\\s*[:\\-]?\\s*)(?P<value>.+)"
      ]
    },
    "place_of_death": {
      "patterns": [
        "(?:PLACE\\s+OF\\s+DEATH\\s*[:\\-]?\\s*)(?P<value>.+)"
      ]
    },
    "cause_of_death": {
      "patterns": [
        "(?:CAUSE\\s+OF\\s+DEATH\\s*[:\\-]?\\s*)(?P<value>.+)",
        "(?:CAUSE\\s*[:\\-]?\\s*)(?P<value>[^\\n]{3,})"
      ]
    }
  }
}

