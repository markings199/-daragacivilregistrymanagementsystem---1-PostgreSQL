# Copy this file to .env and edit for your PostgreSQL server.
# This project copy uses PostgreSQL (not SQLite).

DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/daraga_civil_registry
SECRET_KEY=change-this-secret-key

# Municipal priority backup folder (Daraga office server).
# Examples:
#   \\DARAGA-SERVER\CivilRegistryBackups
#   D:\CivilRegistryBackups
# Leave empty to keep backups only on this computer until the share is ready.
DARAGA_BACKUP_ROOT=
